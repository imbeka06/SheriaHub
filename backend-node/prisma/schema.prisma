// ... existing User model ...

model LegalDocument {
  id          String   @id @default(uuid())
  title       String
  citation    String?
  court       String?  // e.g., "Supreme Court", "High Court"
  year        Int?
  docType     String   @default("CASE") // CASE, STATUTE, CONSTITUTION, JOURNAL
  content     String   @db.Text // The full text of the document
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}