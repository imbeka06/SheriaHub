# ==========================================
# SHERIAHUB ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Copy this file to .env.local in the respective folders 
# (frontend, backend-node, ai-workers) and fill in the values.

# FRONTEND (Place in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=SheriaHub

# BACKEND NODE (Place in backend-node/.env)
PORT=3001
DATABASE_URL=postgres://user:password@ep-cool-db-123456.us-east-2.aws.neon.tech/neondb
JWT_SECRET=generate_a_long_random_string_here

# CLOUDFLARE R2 / AWS S3 (Place in backend-node/.env)
R2_BUCKET_NAME=sheriahub-documents
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com

# AI WORKERS (Place in ai-workers/.env)
GROQ_API_KEY=gsk_your_groq_api_key
OPENROUTER_API_KEY=sk-or-your_openrouter_key
GEMINI_API_KEY=your_google_gemini_key